generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Aircraft {
  id                   String   @id @default(cuid())
  icaoHex              String   @unique
  registration         String?
  aircraftType         String
  verifiedPublicEntity String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  flights              Flight[]

  @@index([registration])
  @@index([verifiedPublicEntity])
}

model Flight {
  id                String             @id @default(cuid())
  aircraftId        String
  originAirport     String
  destinationAirport String
  originAirportIdent String?
  destinationAirportIdent String?
  originCountryCode String?
  destinationCountryCode String?
  attributionSource String?
  attributionConfidence Decimal?
  departureAt       DateTime
  arrivalAt         DateTime?
  distanceKm        Decimal
  estimatedCo2Kg    Decimal
  dataSource        String
  sourceRecordId    String?
  sourceAttribution String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  aircraft          Aircraft           @relation(fields: [aircraftId], references: [id], onDelete: Cascade)

  @@index([departureAt])
  @@index([dataSource])
  @@index([aircraftId, departureAt])
  @@unique([dataSource, sourceRecordId])
}

model EmissionFactor {
  id          String   @id @default(cuid())
  aircraftType String   @unique
  kgCo2PerKm  Decimal
  basis       String   @default("kg_co2_per_km")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ImportLog {
  id                String   @id @default(cuid())
  provider          String
  mode              String?
  timestamp         DateTime @default(now())
  runStartedAt      DateTime?
  runEndedAt        DateTime?
  status            String
  recordsFetched    Int      @default(0)
  recordsConsidered Int      @default(0)
  recordsImported   Int      @default(0)
  errors            String?

  @@index([provider, mode, timestamp])
}

model IngestionCursor {
  id                      String   @id @default(cuid())
  provider                String
  mode                    String
  lastImportedAt          DateTime?
  lastSuccessfulImportAt  DateTime?
  lastRunAt               DateTime?
  lastStatus              String?
  lastError               String?
  recordsImported         Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([provider, mode])
  @@index([provider, mode, lastSuccessfulImportAt])
}

model ProcessedArchiveDate {
  id                  String   @id @default(cuid())
  provider            String
  dateKey             String
  status              String
  releaseTag          String?
  assetNames          String?
  filesScanned        Int      @default(0)
  filesMatched        Int      @default(0)
  recordsParsed       Int      @default(0)
  privateJetMatches   Int      @default(0)
  recordsImported     Int      @default(0)
  error               String?
  processedAt         DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([provider, dateKey])
  @@index([provider, status])
}

model AggregateRollup {
  id              String          @id @default(cuid())
  period          String
  group           String
  key             String          @default("ALL")
  periodStart     DateTime
  flights         Int             @default(0)
  distanceKm      Decimal
  estimatedCo2Kg  Decimal
  updatedAt       DateTime        @updatedAt

  @@unique([period, group, key, periodStart])
  @@index([period, group, periodStart])
}

model CruiseShip {
  id             String   @id @default(cuid())
  imo            String?  @unique
  mmsi           String?  @unique
  name           String
  operator       String?
  shipType       String?  @map("ship_type")
  destination    String?
  grossTonnage   Decimal? @map("gross_tonnage")
  length         Decimal?
  width          Decimal?
  source         String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  positions      CruisePosition[]
  annualEmissions CruiseEmissionsAnnual[]
  dailyEstimates CruiseEmissionsDailyEstimate[]

  @@index([name])
  @@index([operator])
  @@map("cruise_ships")
}

model CruisePosition {
  id                 String    @id @default(cuid())
  shipId             String    @map("ship_id")
  mmsi               String
  latitude           Decimal
  longitude          Decimal
  speedOverGround    Decimal?  @map("speed_over_ground")
  courseOverGround   Decimal?  @map("course_over_ground")
  heading            Int?
  navigationalStatus String?   @map("navigational_status")
  destination        String?
  timestamp          DateTime
  rawPayload         Json?     @map("raw_payload")
  ship               CruiseShip @relation(fields: [shipId], references: [id], onDelete: Cascade)

  @@index([mmsi, timestamp])
  @@index([shipId, timestamp])
  @@unique([mmsi, timestamp, latitude, longitude])
  @@map("cruise_positions")
}

model CruiseEmissionsAnnual {
  id                 String    @id @default(cuid())
  shipId             String    @map("ship_id")
  imo                String
  reportingYear      Int       @map("reporting_year")
  annualCo2Tonnes    Decimal   @map("annual_co2_tonnes")
  annualFuelTonnes   Decimal?  @map("annual_fuel_tonnes")
  distanceNm         Decimal?  @map("distance_nm")
  timeAtSeaHours     Decimal?  @map("time_at_sea_hours")
  source             String
  rawPayload         Json?     @map("raw_payload")
  ship               CruiseShip @relation(fields: [shipId], references: [id], onDelete: Cascade)

  @@unique([shipId, reportingYear])
  @@index([imo])
  @@index([reportingYear])
  @@map("cruise_emissions_annual")
}

model CruiseEmissionsDailyEstimate {
  id                  String    @id @default(cuid())
  shipId              String    @map("ship_id")
  date                DateTime
  estimatedCo2Tonnes  Decimal   @map("estimated_co2_tonnes")
  estimatedFuelTonnes Decimal?  @map("estimated_fuel_tonnes")
  estimatedNoxKg      Decimal?  @map("estimated_nox_kg")
  estimatedSoxKg      Decimal?  @map("estimated_sox_kg")
  distanceNm          Decimal   @map("distance_nm")
  hoursUnderway       Decimal   @map("hours_underway")
  confidenceScore     Decimal   @map("confidence_score")
  methodVersion       String    @map("method_version")
  ship                CruiseShip @relation(fields: [shipId], references: [id], onDelete: Cascade)

  @@unique([shipId, date, methodVersion])
  @@index([date])
  @@index([shipId, date])
  @@map("cruise_emissions_daily_estimates")
}
