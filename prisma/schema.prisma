generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Aircraft {
  id                   String   @id @default(cuid())
  icaoHex              String   @unique
  registration         String?
  aircraftType         String
  verifiedPublicEntity String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  flights              Flight[]

  @@index([registration])
  @@index([verifiedPublicEntity])
}

model Flight {
  id                String             @id @default(cuid())
  aircraftId        String
  originAirport     String
  destinationAirport String
  originAirportIdent String?
  destinationAirportIdent String?
  originCountryCode String?
  destinationCountryCode String?
  attributionSource String?
  attributionConfidence Decimal? @db.Decimal
  departureAt       DateTime
  arrivalAt         DateTime?
  distanceKm        Decimal
  estimatedCo2Kg    Decimal
  dataSource        String
  sourceRecordId    String?
  sourceAttribution String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  aircraft          Aircraft           @relation(fields: [aircraftId], references: [id], onDelete: Cascade)

  @@index([departureAt])
  @@index([dataSource])
  @@index([aircraftId, departureAt])
  @@unique([dataSource, sourceRecordId])
}

model EmissionFactor {
  id          String   @id @default(cuid())
  aircraftType String   @unique
  kgCo2PerKm  Decimal
  basis       String   @default("kg_co2_per_km")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ImportLog {
  id                String   @id @default(cuid())
  provider          String
  mode              String?
  timestamp         DateTime @default(now())
  runStartedAt      DateTime?
  runEndedAt        DateTime?
  status            String
  recordsFetched    Int      @default(0)
  recordsConsidered Int      @default(0)
  recordsImported   Int      @default(0)
  errors            String?

  @@index([provider, mode, timestamp])
}

model IngestionCursor {
  id                      String   @id @default(cuid())
  provider                String
  mode                    String
  lastImportedAt          DateTime?
  lastSuccessfulImportAt  DateTime?
  lastRunAt               DateTime?
  lastStatus              String?
  lastError               String?
  recordsImported         Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([provider, mode])
  @@index([provider, mode, lastSuccessfulImportAt])
}

model ProcessedArchiveDate {
  id                  String   @id @default(cuid())
  provider            String
  dateKey             String
  status              String
  releaseTag          String?
  assetNames          String?
  filesScanned        Int      @default(0)
  filesMatched        Int      @default(0)
  recordsParsed       Int      @default(0)
  privateJetMatches   Int      @default(0)
  recordsImported     Int      @default(0)
  error               String?
  processedAt         DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([provider, dateKey])
  @@index([provider, status])
}

model AggregateRollup {
  id              String          @id @default(cuid())
  period          String
  group           String
  key             String          @default("ALL")
  periodStart     DateTime
  flights         Int             @default(0)
  distanceKm      Decimal
  estimatedCo2Kg  Decimal
  updatedAt       DateTime        @updatedAt

  @@unique([period, group, key, periodStart])
  @@index([period, group, periodStart])
}

model CruiseShip {
  id             String   @id @default(cuid())
  imo            String?  @unique
  mmsi           String?  @unique
  name           String
  operator       String?
  shipType       String?  @map("ship_type")
  destination    String?
  grossTonnage   Decimal? @map("gross_tonnage")
  length         Decimal?
  width          Decimal?
  source         String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  positions      CruisePosition[]
  annualEmissions CruiseEmissionsAnnual[]
  dailyEstimates CruiseEmissionsDailyEstimate[]
  verification   CruiseVesselVerification?

  @@index([name])
  @@index([operator])
  @@map("cruise_ships")
}

model CruisePosition {
  id                 String    @id @default(cuid())
  shipId             String    @map("ship_id")
  mmsi               String
  latitude           Decimal
  longitude          Decimal
  speedOverGround    Decimal?  @map("speed_over_ground")
  courseOverGround   Decimal?  @map("course_over_ground")
  heading            Int?
  navigationalStatus String?   @map("navigational_status")
  destination        String?
  timestamp          DateTime
  rawPayload         Json?     @map("raw_payload")
  ship               CruiseShip @relation(fields: [shipId], references: [id], onDelete: Cascade)

  @@index([mmsi, timestamp])
  @@index([shipId, timestamp])
  @@unique([mmsi, timestamp, latitude, longitude])
  @@map("cruise_positions")
}

model CruiseEmissionsAnnual {
  id                 String    @id @default(cuid())
  shipId             String    @map("ship_id")
  imo                String
  reportingYear      Int       @map("reporting_year")
  annualCo2Tonnes    Decimal   @map("annual_co2_tonnes")
  annualFuelTonnes   Decimal?  @map("annual_fuel_tonnes")
  distanceNm         Decimal?  @map("distance_nm")
  timeAtSeaHours     Decimal?  @map("time_at_sea_hours")
  source             String
  rawPayload         Json?     @map("raw_payload")
  ship               CruiseShip @relation(fields: [shipId], references: [id], onDelete: Cascade)

  @@unique([shipId, reportingYear])
  @@index([imo])
  @@index([reportingYear])
  @@map("cruise_emissions_annual")
}

model CruiseEmissionsDailyEstimate {
  id                  String    @id @default(cuid())
  shipId              String    @map("ship_id")
  date                DateTime
  estimatedCo2Tonnes  Decimal   @map("estimated_co2_tonnes")
  estimatedFuelTonnes Decimal?  @map("estimated_fuel_tonnes")
  estimatedNoxKg      Decimal?  @map("estimated_nox_kg")
  estimatedSoxKg      Decimal?  @map("estimated_sox_kg")
  distanceNm          Decimal   @map("distance_nm")
  hoursUnderway       Decimal   @map("hours_underway")
  confidenceScore     Decimal   @map("confidence_score")
  methodVersion       String    @map("method_version")
  ship                CruiseShip @relation(fields: [shipId], references: [id], onDelete: Cascade)

  @@unique([shipId, date, methodVersion])
  @@index([date])
  @@index([shipId, date])
  @@map("cruise_emissions_daily_estimates")
}

enum CruiseVesselSegment {
  OCEAN_CRUISE
  EXPEDITION_CRUISE
}

enum CruiseRegistryDecision {
  ACCEPT
  EXCLUDE
}

enum CruiseVesselActiveStatus {
  ACTIVE
  RETIRED
  UNKNOWN
}

enum CruiseVerificationStatus {
  VERIFIED_OCEAN_CRUISE
  REVIEW_REQUIRED
  EXCLUDED_NON_CRUISE
  UNASSESSED
}

enum CruiseVerificationConfidence {
  HIGH
  MEDIUM
  LOW
}

model CruiseVesselRegistryEntry {
  id               String                    @id @default(cuid())
  imo              String                    @unique
  canonicalName    String                    @map("canonical_name")
  operator         String
  operatorGroup    String?                   @map("operator_group")
  vesselSegment    CruiseVesselSegment       @map("vessel_segment")
  registryDecision CruiseRegistryDecision    @map("registry_decision")
  activeStatus     CruiseVesselActiveStatus  @map("active_status")
  sourceName       String                    @map("source_name")
  sourceUrl        String                    @map("source_url")
  sourceCheckedAt  DateTime                  @map("source_checked_at")
  notes            String?
  evidence         Json?
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  verifications    CruiseVesselVerification[]
  staticReviewQueue CruiseStaticDataReviewQueue[]

  @@index([registryDecision])
  @@index([vesselSegment])
  @@map("cruise_vessel_registry_entries")
}

model CruiseVesselVerification {
  id                 String                         @id @default(cuid())
  shipId             String                         @unique @map("ship_id")
  registryEntryId    String?                        @map("registry_entry_id")
  verificationStatus CruiseVerificationStatus       @map("verification_status")
  confidence         CruiseVerificationConfidence
  decisionSource     String                         @map("decision_source")
  evidence           Json?
  assessedAt         DateTime?                      @map("assessed_at")
  createdAt          DateTime                       @default(now()) @map("created_at")
  updatedAt          DateTime                       @updatedAt @map("updated_at")
  ship               CruiseShip                     @relation(fields: [shipId], references: [id], onDelete: Cascade)
  registryEntry      CruiseVesselRegistryEntry?     @relation(fields: [registryEntryId], references: [id], onDelete: SetNull)

  @@index([verificationStatus])
  @@index([registryEntryId])
  @@map("cruise_vessel_verifications")
}

enum CruiseStaticReviewClassification {
  ALREADY_LINKED_CONFIRMATION
  NEW_MMSI_CANDIDATE_FOR_EXISTING_REGISTRY_ENTRY
  MMSI_CONFLICT_REVIEW_REQUIRED
}

enum CruiseStaticReviewStatus {
  PENDING
  REVIEWED
  DISMISSED
}

model CruiseStaticDataReviewQueue {
  id                String                            @id @default(cuid())
  registryEntryId   String                            @map("registry_entry_id")
  observedMmsi      String                            @map("observed_mmsi")
  observedAt        DateTime                          @map("observed_at")
  classification    CruiseStaticReviewClassification
  source            String                            @default("GLOBAL_LOCAL_FILTER")
  firstSeenAt       DateTime                          @default(now()) @map("first_seen_at")
  lastSeenAt        DateTime                          @default(now()) @map("last_seen_at")
  occurrenceCount   Int                               @default(1) @map("occurrence_count")
  reviewStatus      CruiseStaticReviewStatus          @default(PENDING) @map("review_status")
  resolvedAt        DateTime?                         @map("resolved_at")
  resolutionNotes   String?                           @map("resolution_notes")
  createdAt         DateTime                          @default(now()) @map("created_at")
  updatedAt         DateTime                          @updatedAt @map("updated_at")
  registryEntry     CruiseVesselRegistryEntry         @relation(fields: [registryEntryId], references: [id], onDelete: Cascade)

  @@unique([registryEntryId, observedMmsi, classification])
  @@index([classification])
  @@index([reviewStatus])
  @@index([lastSeenAt])
  @@map("cruise_static_data_review_queue")
}
